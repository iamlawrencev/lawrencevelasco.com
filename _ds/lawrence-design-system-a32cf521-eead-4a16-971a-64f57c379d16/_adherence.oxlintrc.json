      {
        "selector": "JSXOpeningElement[name.name='InlineStatus'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|error|info)$/]",
        "message": "<InlineStatus> tone must be one of 'success' | 'warning' | 'error' | 'info'."
