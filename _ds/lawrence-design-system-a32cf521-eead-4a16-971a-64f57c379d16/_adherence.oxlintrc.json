        "message": "<FloatingAction> doesn't accept that prop. Declared props: icon, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|children|key|ref|className|style|children)$/]",
        "message": "<FormGroup> doesn't accept that prop. Declared props: title, description, children."
